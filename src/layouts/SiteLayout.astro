---
import { booking, office, reservation, site } from '../lib/site.mjs';
import { pageGraph } from '../lib/schema.mjs';
import { scene } from '../lib/scene.mjs';
import { sitePath } from '../lib/paths.mjs';
import font from '../assets/roboto-latin.woff2?url';
import '../styles/site.css';
const { title, description, article, path } = Astro.props;
const canonical = new URL(sitePath(path), Astro.site).href;
const jsonLd = JSON.stringify(pageGraph(site, Astro.site.origin, path, title, description, article)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={sitePath('/icon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(scene.image.src, Astro.site).href} />
    <meta property="og:image:alt" content={scene.alt} />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip button" href="#contenido">Saltar al contenido</a>
    <header class="masthead">
      <div class="wrap mast-inner">
        <a class="mast-title" href={sitePath('/')} aria-label={site.name + ', inicio'}>
          <strong>{site.masthead}</strong><small>{site.locality}</small>
        </a>
        <nav aria-label="Navegación principal"><ul>
          <li><a href={sitePath('/#calculadora')}>Calcular viajes</a></li>
          <li><a href={sitePath('/blog/')} aria-current={path === '/blog/' ? 'page' : undefined}>Guías</a></li>
          <li class="office-nav"><a href={sitePath('/#oficina')}>Oficina</a></li>
        </ul></nav>
        <a class="mast-phone" href={'tel:' + office.phone} aria-label={'Llamar a la oficina de Sondika al ' + office.displayPhone}>
          <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5.4 3.5 8.5 3l2.2 5-2.4 1.9a14 14 0 0 0 5.8 5.8l1.9-2.4 5 2.2-.5 3.1a2.2 2.2 0 0 1-2.5 1.9C10.7 19.4 4.6 13.3 3.5 6a2.2 2.2 0 0 1 1.9-2.5Z"/></svg>
          {office.displayPhone}
        </a>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a href={sitePath('/')} class="mast-title" aria-label={site.name + ', inicio'}><strong>{site.masthead}</strong><small>{site.locality}</small></a>
        <nav aria-label="Oficina y reservas"><a href={reservation}>Oficina de Sondika</a><a href={booking}>Web de reservas</a><a href="https://www.iberfurgo.com/">Web del operador</a></nav>
      </div>
    </footer>
  </body>
</html>
